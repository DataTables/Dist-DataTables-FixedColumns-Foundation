<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>6.1.0</version>
        <id>datatables.net-fixedcolumns-zf</id>
        <description>This is FixedColumns for DataTables with styling for [Foundation](https://get.foundation/)</description>
        <repository type="git" url="https://github.com/DataTables/FixedColumns"/>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>http://datatables.net</projectUrl>
        <license type="expression">MIT</license>
        <tags>FixedColumns  Foundation  Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-fixedcolumns" version="6.1.0"/>
            <dependency id="datatables.net-zf" version="^3.1"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/fixedColumns.foundation.js" target="content\Scripts"/>
        <file src="js/fixedColumns.foundation.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/fixedColumns.foundation.min.js" target="content\Scripts"/>
        <file src="js/fixedColumns.foundation.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/fixedColumns.foundation.min.mjs" target="content\Scripts"/>
        <file src="js/fixedColumns.foundation.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/fixedColumns.foundation.mjs" target="content\Scripts"/>
        <file src="js/fixedColumns.foundation.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/fixedColumns.foundation.css" target="content\Content"/>
        <file src="css/fixedColumns.foundation.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/fixedColumns.foundation.min.css" target="content\Content"/>
        <file src="css/fixedColumns.foundation.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
